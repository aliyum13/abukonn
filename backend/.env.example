# ABUkonn backend: environment variables.
#
# Copy to backend/.env and fill in. Placeholders only; never commit real values
# (.env is git-ignored; this file is the template). Production values live in
# Railway's Variables tab, not in the repo.
#
# Legend:
#   [REQUIRED]  the backend cannot boot or log anyone in without it
#   [OPTIONAL]  has a safe default, or only one feature depends on it

# ── Database ───────────────────────────────────────────────────────────────

# [REQUIRED] Postgres connection string. The backend creates the `abukonn`
# schema and every table itself on startup, so an empty database is enough.
# Local example (Postgres on its default port):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/abukonn_dev

# ── Auth ───────────────────────────────────────────────────────────────────

# [REQUIRED] Secret used to sign login tokens (JWT). Any long random string for
# development, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Without it the server boots but every login fails.
JWT_SECRET=replace-with-a-long-random-string

# ── Server ─────────────────────────────────────────────────────────────────

# [OPTIONAL] Port the API listens on. Default 3000 (the web app expects this).
PORT=3000

# [OPTIONAL] Extra allowed browser origins for CORS, comma-separated. The web
# dev server (http://localhost:3001) is the default. abukonn.com is always allowed.
CLIENT_URL=http://localhost:3001

# [OPTIONAL] Set to `production` only on the real deployment. Production also
# switches the development fallbacks below OFF, whatever else is set.
NODE_ENV=development

# ── Development fallback ───────────────────────────────────────────────────

# [OPTIONAL, development only] With `true` (and NODE_ENV not `production`), a
# missing RESEND_API_KEY no longer stops the backend booting: emails are written
# to the console instead of sent, which includes the password-reset code. Leave it
# unset on any real deployment.
DEV_SKIP_EXTERNAL_SERVICES=true

# ── Email (Resend) ─────────────────────────────────────────────────────────

# [REQUIRED to boot, unless DEV_SKIP_EXTERNAL_SERVICES=true] Resend API key.
# The mail client is built when the server starts and throws without a key.
# Used for password-reset codes and support-ticket emails.
RESEND_API_KEY=re_replace_me

# [OPTIONAL] Where support tickets are emailed. Defaults to the support inbox.
ADMIN_EMAIL=you@example.com

# ── Media (Cloudinary) ─────────────────────────────────────────────────────

# [OPTIONAL] Needed only for uploads: post/profile/story images and video,
# message images, news images, library files. Without them the server boots and
# everything else works; an upload returns an error. The web and mobile apps
# also fetch a signed upload from /api/stories/upload-signature, which uses these.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# ── Payments (Paystack) ────────────────────────────────────────────────────

# [OPTIONAL] Needed only for the Pro subscription checkout and its webhook.
# Use a TEST key (sk_test_...) for development. Pro screens are hidden by a flag
# until launch, so you can leave this unset.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# ── Monitoring (Sentry) ────────────────────────────────────────────────────

# [OPTIONAL] Error reporting. Unset = disabled (it logs "Sentry DSN not set").
# Leave it unset in development.
SENTRY_DSN=

# ── Push notifications ─────────────────────────────────────────────────────
# No variables. Push goes through Expo's public push service with the device
# tokens apps register, with no server-side key. It is best-effort and only
# delivers to real devices, so it does nothing on a laptop-only setup.

# ── seed-dev.js (scripts/seed-dev.js) only ─────────────────────────────────

# [OPTIONAL] Password for every seed account. Default: DevPass123!
# SEED_DEV_PASSWORD=
# [OPTIONAL] Only if you deliberately seed a NON-local dev database: pass
# --allow-remote AND set this to that database's exact host name.
# SEED_DEV_CONFIRM_HOST=
